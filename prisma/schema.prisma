generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model Collaborateur {
  id                  String               @id @default(uuid())
  nom                 String
  prenom              String
  telephone           String
  email               String?
  photo               String?
  role                String
  entreprise          String?
  dateEmbauche        DateTime?
  adresse             String?
  nationalite         String?
  groupeSanguin       String?
  numeroPieceIdentite String?
  typePieceIdentite   TypePieceIdentite?
  contactUrgenceNom   String?
  contactUrgenceTel   String?
  statut              StatutCollaborateur  @default(ACTIF)
  habilitations       Habilitation[]
  appareils           Appareil[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("collaborateurs")
}

enum TypePieceIdentite {
  CIN
  PASSEPORT
}

enum StatutCollaborateur {
  ACTIF
  INACTIF
  SUSPENDU
}

model Habilitation {
  id                String             @id @default(uuid())
  nom               String
  typeId            String
  typeHabilitation  TypeHabilitation   @relation(fields: [typeId], references: [id], onDelete: Restrict)
  dateObtention     DateTime
  dateExpiration    DateTime
  entreprise        String?
  document          String?
  statut            StatutHabilitation @default(VALIDE)
  collaborateurId   String
  collaborateur     Collaborateur      @relation(fields: [collaborateurId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("habilitations")
}

model TypeHabilitation {
  id            String         @id @default(uuid())
  nom           String         @unique
  description   String?
  entreprise    String?
  dureeValidite String?
  habilitations Habilitation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("type_habilitations")
}

enum StatutHabilitation {
  VALIDE
  EXPIRE
  SUSPENDU
}

model Engin {
  id                      String      @id @default(uuid())
  type                    String
  marque                  String?
  modele                  String?
  immatriculation         String      @unique
  photo                   String?
  lieuAffectation         String?
  dateControle            DateTime?
  dernierVisiteTechnique  DateTime?
  prochainVisiteTechnique DateTime?
  dateExpirationVGP       DateTime?
  dateExpirationAssurance DateTime?
  vgpFournit              String?
  statut                  StatutEngin @default(CONFORME)
  controles               String[]    @default([])
  appareils               Appareil[]
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@map("engins")
}

enum StatutEngin {
  CONFORME
  NON_CONFORME
  EXPIRE_BIENTOT
}

model Appareil {
  id                   String         @id @default(uuid())
  nom                  String
  reference            String         @unique
  type                 String
  statut               StatutAppareil @default(DISPONIBLE)
  localisation         String?
  documentationTechnique String?
  dateAcquisition      DateTime?
  dateDerniereRevision DateTime?
  collaborateurAssigneId String?
  enginAssigneId       String?
  collaborateurAssigne Collaborateur? @relation(fields: [collaborateurAssigneId], references: [id], onDelete: SetNull)
  enginAssigne         Engin?         @relation(fields: [enginAssigneId], references: [id], onDelete: SetNull)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@map("appareils")
}

enum StatutAppareil {
  DISPONIBLE
  EN_SERVICE
  EN_MAINTENANCE
  HORS_SERVICE
}
